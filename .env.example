# Optional server-only token with read:user scope for the profile-visible contribution calendar.
GITHUB_SIGNAL_TOKEN=

# Keep false for local and preview deployments. Set true only for the
# production deployment after eliasb.dev has moved to this project.
SITE_INDEXABLE=false

# Server-only ID of the Sleeper league behind the fantasy ticket. Its league page
# names every team, so it stays out of the repository. Without it there is no
# fantasy pin, and a warning is logged in season.
SLEEPER_LEAGUE_ID=

# Public source identifiers and the expiring status live in
# src/content/integration-config.ts so production has useful defaults.
