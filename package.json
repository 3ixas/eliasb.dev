{
  "name": "eliasb.dev",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "verify:signals": "node --no-warnings --experimental-strip-types scripts/verify-signal-contracts.mjs && node --no-warnings --experimental-strip-types scripts/verify-history-cache.mjs",
    "verify:catalogue": "node --no-warnings --experimental-strip-types scripts/verify-catalogue.mjs",
    "verify:copy": "node --no-warnings --experimental-strip-types scripts/verify-copy.mjs",
    "verify:simulation": "node --no-warnings --experimental-strip-types scripts/verify-simulation.mjs",
    "verify:flowtime-break": "node --no-warnings --experimental-strip-types scripts/verify-flowtime-break.mjs",
    "verify:retired": "node scripts/verify-retired.mjs",
    "verify:type-scale": "node scripts/verify-type-scale.mjs",
    "verify:share-assets": "node --no-warnings --experimental-strip-types scripts/verify-share-assets.mjs",
    "verify:resume": "node --no-warnings --experimental-strip-types scripts/verify-resume-pdf.mjs",
    "verify:routes": "node scripts/verify-canonical-routes.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "verify:craft": "node scripts/verify-craft.mjs",
    "verify:springs": "node --no-warnings --experimental-strip-types scripts/verify-springs.mjs",
    "verify:codex-gate": "node scripts/verify-codex-gate.mjs",
    "verify:link-check": "node scripts/verify-link-check.mjs",
    "links:check": "node scripts/check-external-links.mjs",
    "verify:playwright-image": "node scripts/verify-playwright-image.mjs",
    "verify:ci-coverage": "node scripts/verify-ci-coverage.mjs",
    "check": "pnpm lint && tsc --noEmit --incremental false && pnpm verify:signals && pnpm verify:catalogue && pnpm verify:copy && pnpm verify:simulation && pnpm verify:flowtime-break && pnpm verify:springs && pnpm verify:craft && pnpm verify:type-scale && pnpm verify:retired && pnpm verify:share-assets && pnpm verify:resume && pnpm verify:link-check && pnpm verify:playwright-image && pnpm verify:ci-coverage",
    "check:built": "pnpm verify:routes && pnpm verify:release",
    "test:e2e": "playwright test",
    "test:visual:update": "sh scripts/update-visual-baselines.sh",
    "share:assets": "node --no-warnings --experimental-strip-types scripts/render-share-assets.mjs",
    "resume:pdf": "node --no-warnings --experimental-strip-types scripts/render-resume-pdf.mjs"
  },
  "dependencies": {
    "@vercel/speed-insights": "2.1.0",
    "next": "16.4.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.187.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "motion": "^13.5.0",
    "pdfjs-dist": "^6.4.299",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.11.0"
}
