{
  "name": "eliasb.dev",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "verify:signals": "node --no-warnings --experimental-strip-types scripts/verify-signal-contracts.mjs && node --no-warnings --experimental-strip-types scripts/verify-history-cache.mjs",
    "verify:catalogue": "node --no-warnings --experimental-strip-types scripts/verify-catalogue.mjs",
    "verify:copy": "node --no-warnings --experimental-strip-types scripts/verify-copy.mjs",
    "verify:retired": "node scripts/verify-retired.mjs",
    "verify:type-scale": "node scripts/verify-type-scale.mjs",
    "verify:resume": "node --no-warnings --experimental-strip-types scripts/verify-resume-pdf.mjs",
    "verify:routes": "node scripts/verify-canonical-routes.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "verify:springs": "node --no-warnings --experimental-strip-types scripts/verify-springs.mjs",
    "verify:codex-gate": "node scripts/verify-codex-gate.mjs",
    "verify:link-check": "node scripts/verify-link-check.mjs",
    "links:check": "node scripts/check-external-links.mjs",
    "verify:playwright-image": "node scripts/verify-playwright-image.mjs",
    "verify:ci-coverage": "node scripts/verify-ci-coverage.mjs",
    "check": "pnpm lint && tsc --noEmit --incremental false && pnpm verify:signals && pnpm verify:catalogue && pnpm verify:copy && pnpm verify:springs && pnpm verify:type-scale && pnpm verify:retired && pnpm verify:resume && pnpm verify:link-check && pnpm verify:playwright-image && pnpm verify:ci-coverage",
    "check:built": "pnpm verify:routes && pnpm verify:release",
    "test:e2e": "playwright test",
    "resume:pdf": "node --no-warnings --experimental-strip-types scripts/render-resume-pdf.mjs"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "motion": "^13.5.0",
    "pdfjs-dist": "^6.4.299",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.11.0"
}
